# Один кабинет — один токен для всех разрешённых ему категорий WB API.
# Добавляйте WB_TOKEN_2, WB_TOKEN_3 и далее — кабинеты появятся автоматически.
WB_TOKEN_1=вставьте_токен_первого_кабинета
WB_CABINET_1_NAME=Основной кабинет
# WB_TOKEN_2=вставьте_токен_второго_кабинета
# WB_CABINET_2_NAME=Второй кабинет

PORT=4173
WB_DEMO_MODE=true

# Google Таблица (google-sheets/README.md): история цен, статусов и ставок для графика цены и истории кампании.
# Адрес — развёртывание веб-приложения скрипта, ключ — в таблице «WB → Ключ для сайта».
# WB_SHEET_URL=https://script.google.com/macros/s/<идентификатор развёртывания>/exec
# WB_SHEET_KEY=ключ_из_таблицы

# Отдельная Google Таблица с оптовыми ценами Сималенда (google-sheets/sima-land/README.md): раздел «Цены Сималенда».
# Сервер раз в час загружает цены с Сималенда и записывает в неё. Адрес — развёртывание веб-приложения её скрипта,
# ключ — в таблице «Сималенд → Ключ для сайта». Токен Сималенда необязателен: с ним — цены для вашего аккаунта
# (создаётся на https://www.sima-land.ru/cabinet/token/).
# SIMA_SHEET_URL=https://script.google.com/macros/s/<идентификатор развёртывания>/exec
# SIMA_SHEET_KEY=ключ_из_таблицы
# SIMA_TOKEN=токен_сималенда
